rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped Super Admin (requires verified Firebase Auth email claim)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'priyanjithdeepal951@gmail.com';
    }

    // Admin check: bootstrapped super admin OR verified user listed in /admins/{uid}
    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isProjectMember(projectData) {
      return isSignedIn() && (
        projectData.userId == request.auth.uid ||
        (projectData.keys().hasAny(['collaboratorUids']) &&
         projectData.collaboratorUids is list &&
         request.auth.uid in projectData.collaboratorUids)
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name']) &&
             data.keys().hasOnly(['id', 'email', 'name', 'avatar', 'role', 'isSuspended', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size() <= 500)) &&
             (!data.keys().hasAny(['role']) || data.role in ['Creator', 'Pro Creator', 'Moderator', 'Admin']) &&
             (!data.keys().hasAny(['isSuspended']) || data.isSuspended is bool) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category in ['Landing', 'Portfolio', 'E-Commerce', 'Web Apps'] &&
             data.status in ['Active', 'Draft', 'Published'] &&
             data.blocks is list && data.blocks.size() <= 500 &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500)) &&
             (!data.keys().hasAny(['pages']) || (data.pages is list && data.pages.size() <= 50));
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['brandName', 'heroTitle', 'maintenanceMode', 'allowSignups']) &&
             data.keys().hasOnly([
               'brandName', 'heroKicker', 'heroTitle', 'heroHighlight', 'heroSubtitle',
               'heroPrimaryCta', 'heroSecondaryCta', 'announcementEnabled', 'announcementText',
               'maintenanceMode', 'maintenanceMessage', 'allowSignups', 'allowDemoLogin',
               'maxProjectsPerUser', 'defaultTheme', 'footerCopyright', 'footerLinksText',
               'templates', 'updatedAt', 'updatedBy'
             ]) &&
             data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 80 &&
             data.heroTitle is string && data.heroTitle.size() > 0 && data.heroTitle.size() <= 200 &&
             data.maintenanceMode is bool &&
             data.allowSignups is bool &&
             (!data.keys().hasAny(['heroKicker']) || (data.heroKicker is string && data.heroKicker.size() <= 160)) &&
             (!data.keys().hasAny(['heroHighlight']) || (data.heroHighlight is string && data.heroHighlight.size() <= 120)) &&
             (!data.keys().hasAny(['heroSubtitle']) || (data.heroSubtitle is string && data.heroSubtitle.size() <= 600)) &&
             (!data.keys().hasAny(['heroPrimaryCta']) || (data.heroPrimaryCta is string && data.heroPrimaryCta.size() <= 80)) &&
             (!data.keys().hasAny(['heroSecondaryCta']) || (data.heroSecondaryCta is string && data.heroSecondaryCta.size() <= 80)) &&
             (!data.keys().hasAny(['announcementEnabled']) || data.announcementEnabled is bool) &&
             (!data.keys().hasAny(['announcementText']) || (data.announcementText is string && data.announcementText.size() <= 240)) &&
             (!data.keys().hasAny(['maintenanceMessage']) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 400)) &&
             (!data.keys().hasAny(['allowDemoLogin']) || data.allowDemoLogin is bool) &&
             (!data.keys().hasAny(['maxProjectsPerUser']) || (data.maxProjectsPerUser is int && data.maxProjectsPerUser >= 1 && data.maxProjectsPerUser <= 1000)) &&
             (!data.keys().hasAny(['defaultTheme']) || data.defaultTheme in ['cosmic', 'cyberpunk', 'emerald', 'amber', 'titanium']) &&
             (!data.keys().hasAny(['footerCopyright']) || (data.footerCopyright is string && data.footerCopyright.size() <= 160)) &&
             (!data.keys().hasAny(['footerLinksText']) || (data.footerLinksText is string && data.footerLinksText.size() <= 160)) &&
             (!data.keys().hasAny(['templates']) || (data.templates is list && data.templates.size() <= 24)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'grantedBy', 'grantedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'role', 'grantedBy', 'grantedAt']) &&
             isValidId(data.uid) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.role in ['Super Admin', 'Admin'] &&
             data.grantedBy is string && data.grantedBy.size() > 0 && data.grantedBy.size() <= 200 &&
             data.grantedAt is string && data.grantedAt.size() > 0 && data.grantedAt.size() <= 64;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
             data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt']) &&
             isValidId(data.id) &&
             data.actorUid is string && data.actorUid.size() > 0 && data.actorUid.size() <= 128 &&
             data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 200 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 100 &&
             data.targetType in ['settings', 'user', 'project', 'admin', 'security'] &&
             data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 128 &&
             data.details is string && data.details.size() > 0 && data.details.size() <= 500 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64;
    }

    // Health / connection test document
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Global Site CMS & Platform Configuration (non-PII public config, admin-only write)
    match /appConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if isAdmin();
      allow create, update: if isValidId(configId) && isAdmin() && isValidSiteConfig(incoming());
      allow delete: if false;
    }

    // Admin RBAC Allowlist (strict admin management)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminUid) && isAdmin() && isValidAdminRecord(incoming());
      allow delete: if isValidId(adminUid) && isAdmin() && existing().email != 'priyanjithdeepal951@gmail.com';
    }

    // Immutable Security Audit Trail (admin append & read only)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming()) && incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // User profile documents (anti-privilege-escalation enforced)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(incoming()) && (
        (isOwner(userId) &&
         incoming().id == request.auth.uid &&
         (!incoming().keys().hasAny(['role']) || incoming().role == 'Creator') &&
         (!incoming().keys().hasAny(['isSuspended']) || incoming().isSuspended == false)) ||
        isAdmin()
      );
      allow update: if isValidId(userId) && isValidUser(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'email', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // User web projects & collaborative workspaces
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (isProjectMember(existing()) || isAdmin());
      allow list: if isSignedIn() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        (existing().keys().hasAny(['collaboratorUids']) &&
         existing().collaboratorUids is list &&
         request.auth.uid in existing().collaboratorUids)
      );
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isValidId(projectId) && isValidProject(incoming()) && (
        isAdmin() ||
        (isProjectMember(existing()) && incoming().userId == existing().userId)
      );
      allow delete: if isValidId(projectId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));

      // Real-time project collaborative chat messages
      match /messages/{messageId} {
        allow read: if isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin();
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         (isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin()) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().text is string &&
                         incoming().text.size() > 0 &&
                         incoming().text.size() <= 1000;
        allow delete: if isSignedIn() &&
                         (existing().senderId == request.auth.uid ||
                          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
                          isAdmin());
      }

      // Real-time presence & cursor tracking for active collaborators
      match /presence/{userId} {
        allow read: if isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin();
        allow write: if (isOwner(userId) &&
                         isValidId(userId) &&
                         isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data)) ||
                        isAdmin();
      }
    }
  }
}
