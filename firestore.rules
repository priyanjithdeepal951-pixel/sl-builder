rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isProjectMember(projectData) {
      return isSignedIn() && (
        projectData.userId == request.auth.uid ||
        (projectData.keys().hasAny(['collaboratorUids']) &&
         projectData.collaboratorUids is list &&
         request.auth.uid in projectData.collaboratorUids)
      );
    }

    function isValidUser(data) {
      return data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidProject(data) {
      return data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category in ['Landing', 'Portfolio', 'E-Commerce', 'Web Apps'] &&
             data.status in ['Active', 'Draft', 'Published'] &&
             data.blocks is list && data.blocks.size() <= 500;
    }

    // Health / connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    // User web projects & collaborative workspaces
    match /projects/{projectId} {
      allow get: if isProjectMember(resource.data);
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid in resource.data.collaboratorUids
      );
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isProjectMember(resource.data) && isValidProject(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Real-time project collaborative chat messages
      match /messages/{messageId} {
        allow read: if isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 1000;
        allow delete: if isSignedIn() &&
                         (resource.data.senderId == request.auth.uid ||
                          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid);
      }

      // Real-time presence & cursor tracking for active collaborators
      match /presence/{userId} {
        allow read: if isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow write: if isOwner(userId) &&
                        isValidId(userId) &&
                        isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }
  }
}
