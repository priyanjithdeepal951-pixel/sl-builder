{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID from Firebase Auth"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "avatar": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "role": {
          "type": "string",
          "maxLength": 50,
          "description": "User role"
        },
        "isSuspended": {
          "type": "boolean",
          "description": "Whether account is suspended by an administrator"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "email", "name"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global platform configuration, CMS copy, templates, and security toggles",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 80 },
        "heroKicker": { "type": "string", "maxLength": 160 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroHighlight": { "type": "string", "maxLength": 120 },
        "heroSubtitle": { "type": "string", "maxLength": 600 },
        "heroPrimaryCta": { "type": "string", "maxLength": 80 },
        "heroSecondaryCta": { "type": "string", "maxLength": 80 },
        "announcementEnabled": { "type": "boolean" },
        "announcementText": { "type": "string", "maxLength": 240 },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 400 },
        "allowSignups": { "type": "boolean" },
        "allowDemoLogin": { "type": "boolean" },
        "maxProjectsPerUser": { "type": "integer" },
        "defaultTheme": {
          "type": "string",
          "enum": ["cosmic", "cyberpunk", "emerald", "amber", "titanium"]
        },
        "footerCopyright": { "type": "string", "maxLength": 160 },
        "footerLinksText": { "type": "string", "maxLength": 160 },
        "templates": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["brandName", "heroTitle", "maintenanceMode", "allowSignups"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator allowlist entry keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["Super Admin", "Admin"] },
        "grantedBy": { "type": "string", "maxLength": 200 },
        "grantedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "name", "role", "grantedBy", "grantedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable administrative security audit event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "enum": ["settings", "user", "project", "admin", "security"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "targetType", "targetId", "details", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "SL Builder user and collaborative project document",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique project identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Project title"
        },
        "category": {
          "type": "string",
          "enum": ["Landing", "Portfolio", "E-Commerce", "Web Apps"],
          "description": "Project category"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Draft", "Published"],
          "description": "Publication status"
        },
        "blocks": {
          "type": "array",
          "description": "Array of visual and functional canvas blocks (Home page)"
        },
        "pages": {
          "type": "array",
          "description": "Array of website pages (id, name, slug, blocks) for multi-page projects"
        },
        "collaboratorUids": {
          "type": "array",
          "description": "List of user UIDs who have collaborator access"
        },
        "collaborators": {
          "type": "array",
          "description": "Detailed collaborator records with role, name, and email"
        },
        "thumbnailColor": {
          "type": "string",
          "description": "Accent gradient or color"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Project brief summary"
        },
        "createdAt": {
          "type": "string",
          "description": "Created at timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Updated at timestamp"
        }
      },
      "required": ["id", "userId", "name", "category", "status", "blocks"]
    },
    "ProjectMessage": {
      "title": "ProjectMessage",
      "description": "Real-time team chat message inside a project workspace",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message identifier"
        },
        "projectId": {
          "type": "string",
          "description": "Project reference ID"
        },
        "senderId": {
          "type": "string",
          "description": "User ID of sender"
        },
        "senderName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of sender"
        },
        "senderEmail": {
          "type": "string",
          "description": "Sender email"
        },
        "senderAvatar": {
          "type": "string",
          "description": "Avatar URL of sender"
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "description": "Message content"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when message was sent"
        }
      },
      "required": ["id", "senderId", "senderName", "text", "createdAt"]
    },
    "ProjectPresence": {
      "title": "ProjectPresence",
      "description": "Real-time presence and active cursor of collaborator in project",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Presence document ID (user UID)"
        },
        "userId": {
          "type": "string",
          "description": "Collaborator UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Collaborator display name"
        },
        "avatar": {
          "type": "string",
          "description": "Collaborator avatar image"
        },
        "activeBlockId": {
          "type": "string",
          "description": "Block ID currently being selected or edited"
        },
        "cursorX": {
          "type": "number",
          "description": "Cursor relative X percent"
        },
        "cursorY": {
          "type": "number",
          "description": "Cursor relative Y percent"
        },
        "lastSeen": {
          "type": "string",
          "description": "Heartbeat timestamp"
        }
      },
      "required": ["id", "userId", "name", "lastSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account documents keyed by Auth UID"
    },
    "/appConfig/{configId}": {
      "schema": "SiteSettings",
      "description": "Global platform configuration and CMS copy managed by administrators"
    },
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Trusted administrator RBAC registry keyed by Firebase Auth UID"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Immutable admin security & mutation audit trail"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Visual builder projects belonging to authenticated users or shared with collaborators"
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "ProjectMessage",
      "description": "Real-time chat feed between project collaborators"
    },
    "/projects/{projectId}/presence/{userId}": {
      "schema": "ProjectPresence",
      "description": "Live active collaborator presence, cursors and editing indicators"
    }
  }
}
